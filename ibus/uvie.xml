<?xml version="1.0" encoding="utf-8"?>
<!-- IBus component descriptor for UVie. Install to
     /usr/share/ibus/component/uvie.xml -->
<component>
	<name>org.freedesktop.IBus.Uvie</name>
	<description>UVie Vietnamese Input Method</description>
	<exec>@CMAKE_INSTALL_FULL_LIBEXECDIR@/ibus-engine-uvie --ibus</exec>
	<version>@PROJECT_VERSION@</version>
	<author>UVie Project</author>
	<license>GPL-3.0-or-later</license>
	<homepage>https://github.com/uvie-project/uvie-linux</homepage>
	<textdomain>uvie</textdomain>
	<engines>
		<engine>
			<name>uvie</name>
			<longname>Vietnamese (UVie)</longname>
			<description>Telex/VNI input via the UVie engine</description>
			<language>vi</language>
			<license>GPL-3.0-or-later</license>
			<author>UVie Project</author>
			<icon>ibus-uvie</icon>
			<layout>us</layout>
			<symbol>Vi</symbol>
		</engine>
	</engines>
</component>
