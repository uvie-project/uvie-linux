// UVie settings — Linux mirror of the uvie-mac/uvie-win settings window.
// Same six-pane layout: Tổng quan / Bàn phím / Macro / Ứng dụng /
// Nâng cao / Giới thiệu. Dark theme built around the logo's vermilion.

import { Button, Switch, ComboBox, LineEdit, ListView, ScrollView,
         VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

export struct MacroRow { trigger: string, expansion: string }

// ---- theme ----
global Theme {
    out property <color> bg: #131316;
    out property <color> sidebar: #1b1b1f;
    out property <color> card: #212126;
    out property <color> card-border: #2d2d33;
    out property <color> text: #f2f2f4;
    out property <color> text-dim: #a9a9b2;
    out property <color> accent: #e05038;
    out property <color> accent-dim: #e0503833;
    out property <color> nav-hover: #26262c;
}

component RowLabel inherits Text {
    color: Theme.text;
    font-size: 13px;
    vertical-alignment: center;
}

component Hint inherits Text {
    color: Theme.text-dim;
    font-size: 11.5px;
    wrap: word-wrap;
}

component Toggle inherits Switch {
    height: 24px;
}

// A labeled settings card.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        if title != "": VerticalLayout {
            spacing: 2px;
            Text { text: title; color: Theme.text; font-size: 14px; font-weight: 600; }
            if subtitle != "": Hint { text: subtitle; }
        }
        @children
    }
}

component PageTitle inherits VerticalLayout {
    in property <string> title;
    spacing: 3px;
    padding-bottom: 4px;
    Text { text: title; color: Theme.text; font-size: 20px; font-weight: 700; }
    Rectangle { height: 1px; }
}

export component AppWindow inherits Window {
    title: "UVie — Cài đặt";
    icon: @image-url("../../../assets/logo.png");
    background: Theme.bg;
    min-width: 760px;
    min-height: 520px;
    preferred-width: 800px;
    preferred-height: 560px;

    // ---- state (bound from Rust) ----
    in-out property <int> page: 0;
    in-out property <bool> enabled: true;
    in-out property <int> method: 0;            // 0 telex 1 vni 2 simple-telex
    in-out property <string> hotkey: "Ctrl+Shift+Z";
    in-out property <bool> launch-at-login;
    in-out property <bool> quick-start;
    in-out property <bool> quick-telex;
    in-out property <bool> modern-orthography;
    in-out property <bool> relaxed-coda;
    in-out property <bool> english-override;
    in-out property <bool> auto-capitalize;
    in-out property <bool> per-app-language;
    in-out property <bool> macro-enabled;
    in-out property <int> injection-mode: 2;    // 0 unicode-hex 1 clipboard 2 auto
    in-out property <int> rewrite-mode: 0;      // 0 backspace 1 select-overwrite
    in-out property <[MacroRow]> macros;
    in-out property <[string]> excluded-apps;
    in property <string> version;

    callback save-clicked();
    callback add-macro(string, string);
    callback remove-macro(int);
    callback add-excluded(string);
    callback remove-excluded(int);
    callback open-repo();

    property <[string]> sections: ["Tổng quan", "Bàn phím", "Macro", "Ứng dụng", "Nâng cao", "Giới thiệu"];

    HorizontalBox {
        padding: 0;
        spacing: 0;

        // ---- sidebar ----
        Rectangle {
            width: 190px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 16px;
                spacing: 3px;

                // brand
                HorizontalBox {
                    spacing: 10px;
                    padding-bottom: 14px;
                    Image {
                        source: @image-url("../../../assets/logo.png");
                        width: 34px;
                        height: 34px;
                    }
                    VerticalLayout {
                        spacing: 0;
                        alignment: center;
                        Text { text: "UVie"; color: Theme.text; font-size: 17px; font-weight: 700; }
                        Text { text: "Bộ gõ tiếng Việt"; color: Theme.text-dim; font-size: 10px; }
                    }
                }

                for name[i] in root.sections: Rectangle {
                    height: 34px;
                    border-radius: 8px;
                    background: root.page == i ? Theme.accent-dim : (side-touch.has-hover ? Theme.nav-hover : transparent);
                    side-touch := TouchArea {
                        clicked => { root.page = i; }
                    }
                    // accent rail on the selected item
                    if root.page == i: Rectangle {
                        x: 0;
                        width: 3px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                    Text {
                        x: 14px;
                        text: name;
                        color: root.page == i ? Theme.text : #c9c9cf;
                        font-size: 13px;
                        font-weight: root.page == i ? 600 : 400;
                        vertical-alignment: center;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Text {
                    text: "Phiên bản " + root.version;
                    color: Theme.text-dim;
                    font-size: 10px;
                    horizontal-alignment: left;
                }
            }
        }

        // ---- content ----
        Rectangle {
            background: Theme.bg;
            VerticalBox {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                padding-bottom: 14px;
                spacing: 0;

                ScrollView {
                    vertical-stretch: 1;

                    // ===== Tổng quan =====
                    if root.page == 0: VerticalBox {
                        padding: 2px;
                        spacing: 14px;
                        alignment: start;
                        PageTitle { title: "Tổng quan"; }
                        Card {
                            title: "Chung";
                            HorizontalBox {
                                RowLabel { text: "Bật UVie"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.enabled; }
                            }
                            HorizontalBox {
                                RowLabel { text: "Kiểu gõ"; horizontal-stretch: 1; }
                                ComboBox {
                                    width: 220px;
                                    model: ["Telex", "VNI", "Simple Telex"];
                                    current-index <=> root.method;
                                }
                            }
                            HorizontalBox {
                                RowLabel { text: "Phím tắt chuyển Việt/Anh"; horizontal-stretch: 1; }
                                LineEdit {
                                    width: 220px;
                                    text <=> root.hotkey;
                                    placeholder-text: "Ctrl+Shift+Z";
                                }
                            }
                        }
                        Card {
                            title: "Hệ thống";
                            HorizontalBox {
                                RowLabel { text: "Khởi động cùng hệ thống"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.launch-at-login; }
                            }
                        }
                        Hint {
                            text: "Cài đặt có hiệu lực ngay sau khi bấm Lưu — không cần khởi động lại.";
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    // ===== Bàn phím =====
                    if root.page == 1: VerticalBox {
                        padding: 2px;
                        spacing: 14px;
                        alignment: start;
                        PageTitle { title: "Bàn phím"; }
                        Card {
                            title: "Gõ nhanh";
                            HorizontalBox {
                                RowLabel { text: "Gõ tắt đầu từ (j→gi, f→ph, w→qu)"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.quick-start; }
                            }
                            HorizontalBox {
                                RowLabel { text: "Gõ tắt Telex (cc→ch, gg→gi…)"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.quick-telex; }
                            }
                        }
                        Card {
                            title: "Chính tả & từ điển";
                            HorizontalBox {
                                RowLabel { text: "Chính tả hiện đại (đặt dấu)"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.modern-orthography; }
                            }
                            HorizontalBox {
                                RowLabel { text: "Nới lỏng luật âm cuối"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.relaxed-coda; }
                            }
                            HorizontalBox {
                                RowLabel { text: "Bỏ qua từ tiếng Anh"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.english-override; }
                            }
                            HorizontalBox {
                                RowLabel { text: "Tự động viết hoa đầu câu"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.auto-capitalize; }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    // ===== Macro =====
                    if root.page == 2: VerticalBox {
                        padding: 2px;
                        spacing: 14px;
                        alignment: start;
                        PageTitle { title: "Macro"; }
                        Card {
                            title: "Gõ tắt mở rộng";
                            subtitle: "Chuỗi ngắn được thay bằng nội dung đầy đủ khi gõ.";
                            HorizontalBox {
                                RowLabel { text: "Bật gõ tắt macro"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.macro-enabled; }
                            }
                        }
                        Card {
                            title: "Danh sách macro";
                            vertical-stretch: 1;
                            ListView {
                                vertical-stretch: 1;
                                for row[i] in root.macros: HorizontalBox {
                                    spacing: 8px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    RowLabel {
                                        text: row.trigger;
                                        width: 130px;
                                        font-weight: 600;
                                        color: Theme.accent;
                                    }
                                    RowLabel { text: "→ " + row.expansion; color: Theme.text-dim; horizontal-stretch: 1; }
                                    Button { text: "Xoá"; clicked => { root.remove-macro(i); } }
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                trigger-in := LineEdit { width: 130px; placeholder-text: "vd: sdt"; }
                                expansion-in := LineEdit { horizontal-stretch: 1; placeholder-text: "nội dung mở rộng"; }
                                Button {
                                    text: "Thêm";
                                    clicked => {
                                        root.add-macro(trigger-in.text, expansion-in.text);
                                        trigger-in.text = "";
                                        expansion-in.text = "";
                                    }
                                }
                            }
                        }
                    }

                    // ===== Ứng dụng =====
                    if root.page == 3: VerticalBox {
                        padding: 2px;
                        spacing: 14px;
                        alignment: start;
                        PageTitle { title: "Ứng dụng"; }
                        Card {
                            title: "Theo ứng dụng";
                            subtitle: "Chỉ áp dụng trên màn hình X11.";
                            HorizontalBox {
                                RowLabel { text: "Nhớ ngôn ngữ cho từng ứng dụng"; horizontal-stretch: 1; }
                                Toggle { checked <=> root.per-app-language; }
                            }
                        }
                        Card {
                            title: "Ứng dụng bỏ qua";
                            subtitle: "UVie không can thiệp khi gõ trong các ứng dụng này.";
                            vertical-stretch: 1;
                            ListView {
                                vertical-stretch: 1;
                                for app[i] in root.excluded-apps: HorizontalBox {
                                    spacing: 8px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    RowLabel { text: app; horizontal-stretch: 1; }
                                    Button { text: "Xoá"; clicked => { root.remove-excluded(i); } }
                                }
                            }
                            HorizontalBox {
                                spacing: 8px;
                                app-in := LineEdit { horizontal-stretch: 1; placeholder-text: "tên ứng dụng, vd: chromium"; }
                                Button {
                                    text: "Thêm";
                                    clicked => {
                                        root.add-excluded(app-in.text);
                                        app-in.text = "";
                                    }
                                }
                            }
                        }
                    }

                    // ===== Nâng cao =====
                    if root.page == 4: VerticalBox {
                        padding: 2px;
                        spacing: 14px;
                        alignment: start;
                        PageTitle { title: "Nâng cao"; }
                        Card {
                            title: "Nhập liệu";
                            HorizontalBox {
                                RowLabel { text: "Cách chèn ký tự có dấu"; horizontal-stretch: 1; }
                                ComboBox {
                                    width: 260px;
                                    model: ["Nhập mã Unicode (Ctrl+Shift+U)", "Dán qua bộ nhớ tạm", "Tự động"];
                                    current-index <=> root.injection-mode;
                                }
                            }
                            HorizontalBox {
                                RowLabel { text: "Cách xoá khi sửa lại từ"; horizontal-stretch: 1; }
                                ComboBox {
                                    width: 260px;
                                    model: ["Xoá lùi từng ký tự", "Bôi chọn rồi ghi đè"];
                                    current-index <=> root.rewrite-mode;
                                }
                            }
                        }
                        Hint {
                            text: "«Bôi chọn rồi ghi đè» tự được dùng cho trình duyệt Chromium (Chrome, Edge…) — giống bản macOS và Windows.";
                        }
                        Rectangle { vertical-stretch: 1; }
                    }

                    // ===== Giới thiệu =====
                    if root.page == 5: VerticalBox {
                        padding: 2px;
                        spacing: 14px;
                        alignment: start;
                        PageTitle { title: "Giới thiệu"; }
                        Card {
                            HorizontalBox {
                                spacing: 16px;
                                Image {
                                    source: @image-url("../../../assets/logo.png");
                                    width: 72px;
                                    height: 72px;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text { text: "UVie for Linux"; color: Theme.text; font-size: 20px; font-weight: 700; }
                                    Hint {
                                        text: "Bộ gõ tiếng Việt Telex/VNI cho Linux — gõ mượt trên mọi môi trường đồ hoạ, kể cả Wayland.";
                                    }
                                    HorizontalBox {
                                        padding-top: 4px;
                                        alignment: start;
                                        Button {
                                            text: "GitHub — uvie-project/uvie-linux";
                                            clicked => { root.open-repo(); }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // ---- save bar ----
                Rectangle {
                    height: 1px;
                    background: Theme.card-border;
                }
                HorizontalBox {
                    padding-top: 12px;
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "Lưu";
                        primary: true;
                        clicked => { root.save-clicked(); }
                    }
                }
            }
        }
    }
}
